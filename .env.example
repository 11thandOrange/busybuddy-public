# ---- Backend ----
# Port the Express API listens on
PORT=3001
# Comma-separated list of allowed CORS origins (frontend dev + prod)
CORS_ORIGIN=http://localhost:5173
# Where the JSON datastore files live (relative to backend/ or absolute)
DATA_DIR=./data

# ---- Frontend (Vite) ----
# Base URL the frontend uses to reach the backend API.
# Leave blank to use the Vite dev proxy ("/api" -> backend).
VITE_API_BASE_URL=
